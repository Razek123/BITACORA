rules_version = '2';

// Bitácora · reglas de Firestore
// Solo usuarios autenticados (la app inicia sesión anónima automáticamente).
// Además se valida la forma de cada registro para evitar datos basura.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validGasto(d) {
      return d.empresa in ['LGHT', 'Nuvixa']
        && d.metodoPago in ['Tarjeta de Crédito', 'Efectivo']
        && d.monto is number && d.monto > 0 && d.monto < 10000000
        && d.concepto is string && d.concepto.size() > 0 && d.concepto.size() <= 200
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.metodoPago == 'Tarjeta de Crédito' || d.estadoReembolso in ['Pendiente', 'Pagado']);
    }

    function validSalida(d) {
      return d.empresa in ['LGHT', 'Nuvixa']
        && d.destino is string && d.destino.size() > 0 && d.destino.size() <= 160
        && d.responsable is string && d.responsable.size() > 0
        && d.fechaSalida is string && d.fechaSalida.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.items is list && d.items.size() > 0 && d.items.size() <= 300
        && d.folio is int && d.folio > 0;
    }

    match /gastos/{gastoId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validGasto(request.resource.data);
      allow delete: if signedIn();
    }

    // Vales de salida de material y herramienta
    match /salidas/{salidaId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validSalida(request.resource.data);
      allow delete: if signedIn();
    }

    // Contador de folios (S-0001, S-0002…)
    match /contadores/salidas {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.ultimo is int
        && (!exists(/databases/$(database)/documents/contadores/salidas)
            || request.resource.data.ultimo == resource.data.ultimo + 1);
    }
  }
}
